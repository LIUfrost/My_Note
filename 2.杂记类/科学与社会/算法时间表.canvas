	"nodes":[
		{"id":"331fdadca5d090c6","x":-480,"y":-160,"width":280,"height":100,"color":"5","type":"text","text":"2012   AlexNet\n深层CNN+ReLU+Dropout\n首次在ImageNet碾压传统方法\n"},
		{"id":"5c58587e40bf9a26","x":-60,"y":-160,"width":240,"height":100,"color":"5","type":"text","text":"2014 VGGNet\n3\\*3小卷积堆叠\n医学图像特征提取更细腻"},
		{"id":"486b807eecb3446f","x":280,"y":-160,"width":260,"height":100,"color":"5","type":"text","text":"2015  U-Net\n编码 - 解码 + 跳连\n像素级分割，肺结节分割标杆"},
		{"id":"229c1e422149eb26","x":-780,"y":-160,"width":250,"height":100,"color":"4","type":"text","text":"年份  里程碑模型\n关键创新\n医学影像突破"},
		{"id":"8d93a4a9fe94b076","x":315,"y":100,"width":250,"height":100,"color":"5","type":"text","text":"2017  ResNet\n残差连接\n解决深层网络退化，肺结节分类准确率上升"},
		{"id":"a5b1255024affecb","x":-60,"y":100,"width":250,"height":100,"color":"5","type":"text","text":"2017  GAN\n对抗训练\n数据增强（生成伪CT)，去噪\n"},
		{"id":"b507f9da02cdcdd3","x":-450,"y":100,"width":250,"height":100,"color":"5","type":"text","text":"2018  DenseNet\n密集连接\n特征复用，减少参数"},
		{"id":"fab96664b4846b5d","x":-785,"y":318,"width":270,"height":100,"color":"5","type":"text","text":"2021  Swin Transformer\n窗口自注意力\n计算复杂度下降，3D CT可行"},
		{"id":"e68c65ffd11ec678","x":-425,"y":318,"width":250,"height":100,"color":"5","type":"text","text":"2023  SAM\n提示驱动通用分割\n零样本医学分割"},
		{"id":"2775f2a4d5dff5c7","x":-60,"y":313,"width":300,"height":105,"color":"5","type":"text","text":"2024  Mamba\n状态空间模型（SSM）\n长序列建模，处理高分辨率眼底图"},
		{"id":"f6ec63c45a07f0a1","x":315,"y":313,"width":250,"height":105,"color":"5","type":"text","text":"2025  Med - STD\n空间 - 时序解耦\n肺结节随访倍增时间预测"},
		{"id":"f345254c6242d87a","x":-795,"y":100,"width":280,"height":100,"color":"5","type":"text","text":"2020  Vision Transformer(VIT)\n自注意力\n全局建模，眼底多病灶关联"}
